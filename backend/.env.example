# Database
DATABASE_URL=postgresql+asyncpg://querymind:querymind@localhost:5432/querymind
DATABASE_URL_SYNC=postgresql+psycopg2://querymind:querymind@localhost:5432/querymind

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=1000

# SQL Config
SQL_DIALECT=postgresql
SQL_MAX_ROWS=500

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# App
APP_ENV=development
SECRET_KEY=change-me-in-production
